# Copy to .env for local development (node dev-server.js). On Vercel, set these
# under Project Settings -> Environment Variables instead. Never commit .env.

# Free key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# Optional: models to try in order (defaults shown)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash

# Optional fallback provider: OpenRouter free models (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free

# Optional: provider order (default gemini,openrouter)
# AI_PROVIDER_ORDER=gemini,openrouter
